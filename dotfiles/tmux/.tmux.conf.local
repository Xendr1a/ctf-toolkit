# ~/.tmux.conf.local — 本地覆盖
# gpakosz/.tmux 会 source 本文件；主题引擎读取下面的 tmux_conf_* 变量。

# -- 会话与窗口 ----------------------------------------------------------------
tmux_conf_new_window_retain_current_path=false
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false
tmux_conf_new_session_prompt=false

# -- 真彩色 --------------------------------------------------------------------
tmux_conf_theme_24b_colour=true
tmux_conf_24b_colour=true
set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB"

# -- Dragon Mist：与 kanagawa-dragon / alacritty 对齐 ---------------------------
mist_pill='#302e2a'      # 当前窗口 / 提示块
mist_line='#403e3a'      # 分隔线
mist_dim='#9aa19a'       # 次要文本
mist_fg='#c5c9c5'        # 正文
mist_crisp='#d7dbd5'     # 高亮文本
mist_blue='#9fb9c5'
mist_aqua_dim='#7f8d88'
mist_yellow='#cfbd95'
mist_red='#cd8781'

# 窗口内容保持终端默认底色
tmux_conf_theme_window_fg="default"
tmux_conf_theme_window_bg="default"

# 焦点窗格不铺色
tmux_conf_theme_highlight_focused_pane=false
tmux_conf_theme_focused_pane_fg='default'
tmux_conf_theme_focused_pane_bg=$mist_pill

# 窗格边框
tmux_conf_theme_pane_border_style=thin
tmux_conf_theme_pane_border=$mist_line
tmux_conf_theme_pane_active_border=$mist_aqua_dim
tmux_conf_theme_pane_indicator=$mist_dim
tmux_conf_theme_pane_active_indicator=$mist_blue

# 消息 / 命令提示 / 复制模式
tmux_conf_theme_message_fg=$mist_crisp
tmux_conf_theme_message_bg=$mist_pill
tmux_conf_theme_message_attr="none"
tmux_conf_theme_message_command_fg=$mist_fg
tmux_conf_theme_message_command_bg=$mist_line
tmux_conf_theme_message_command_attr="none"
tmux_conf_theme_mode_fg=$mist_crisp
tmux_conf_theme_mode_bg=$mist_line
tmux_conf_theme_mode_attr="none"

# 状态栏：透明底，只留文字
tmux_conf_theme_status_fg=$mist_dim
tmux_conf_theme_status_bg="default"
tmux_conf_theme_status_attr="none"
tmux_conf_theme_terminal_title="#S · #W"

# 窗口标签：当前窗口用极浅色块
tmux_conf_theme_window_status_fg=$mist_dim
tmux_conf_theme_window_status_bg="default"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_window_status_format="#I #W"
tmux_conf_theme_window_status_current_fg=$mist_crisp
tmux_conf_theme_window_status_current_bg=$mist_pill
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format="#I #W"
tmux_conf_theme_window_status_activity_fg=$mist_yellow
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="none"
tmux_conf_theme_window_status_bell_fg=$mist_red
tmux_conf_theme_window_status_bell_bg="default"
tmux_conf_theme_window_status_bell_attr="none"
tmux_conf_theme_window_status_last_fg="default"
tmux_conf_theme_window_status_last_bg="default"
tmux_conf_theme_window_status_last_attr="none"
tmux_conf_theme_window_status_last_format="#I #W"

# 不使用 powerline 分隔符
tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=''
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=''

# 左：会话名；右：时间
tmux_conf_theme_status_left=" #S "
tmux_conf_theme_status_right=" %H:%M "
tmux_conf_theme_status_left_fg=$mist_fg
tmux_conf_theme_status_left_bg="default"
tmux_conf_theme_status_left_attr="none"
tmux_conf_theme_status_right_fg=$mist_dim
tmux_conf_theme_status_right_bg="default"
tmux_conf_theme_status_right_attr="none"

# 状态指示（当前状态栏内容未启用，保持低对比可用）
tmux_conf_theme_pairing="⚇"
tmux_conf_theme_pairing_fg=$mist_dim
tmux_conf_theme_pairing_bg="default"
tmux_conf_theme_pairing_attr="none"
tmux_conf_theme_prefix="⌨"
tmux_conf_theme_prefix_fg=$mist_yellow
tmux_conf_theme_prefix_bg="default"
tmux_conf_theme_prefix_attr="none"
tmux_conf_theme_mouse="🐭"
tmux_conf_theme_mouse_fg=$mist_dim
tmux_conf_theme_mouse_bg="default"
tmux_conf_theme_mouse_attr="none"
tmux_conf_theme_root="!"
tmux_conf_theme_root_fg=$mist_red
tmux_conf_theme_root_bg="default"
tmux_conf_theme_root_attr="bold"
tmux_conf_theme_synchronized="⚏"
tmux_conf_theme_synchronized_fg=$mist_yellow
tmux_conf_theme_synchronized_bg="default"
tmux_conf_theme_synchronized_attr="none"

# 时钟（<prefix> + t）
tmux_conf_theme_clock_colour=$mist_dim
tmux_conf_theme_clock_style="24"

# -- 其它 ----------------------------------------------------------------------
tmux_conf_copy_to_os_clipboard=true
set -g mouse on
tmux_conf_update_plugins_on_launch=false
tmux_conf_update_plugins_on_reload=false

# session group: 多终端视图取最小尺寸，保证小窗口能看全
set -g window-size smallest

# 每个 view 按自己 client 的尺寸重排，切换时窗口自适应
set -g aggressive-resize on
